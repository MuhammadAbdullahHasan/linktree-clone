# Database. Leave unset to use the local file data/linkfolio.db.
# On Vercel, set these to your Turso database URL (libsql://...) and auth token.
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Public address of the site, used for share links and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# People need this code to create an account. Leave empty to allow open sign-ups.
INVITE_CODE=

# Emails (comma-separated) that can run customer profiles from Dashboard → Profiles and
# sign in to the Control Room API (POST /api/admin/login). Leave empty to turn that off.
ADMIN_EMAIL=
